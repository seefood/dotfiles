{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "aws-mcp": {
      "command": [
        "uvx",
        "mcp-proxy-for-aws@latest",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--metadata",
        "INSTALL_SOURCE=aws-cli"
      ],
      "type": "local"
    }
  },
  "provider": {
    "litellm": {
      "models": {
        "qwen3.6-35b-a3b": {
          "name": "Qwen3.6-35B-A3B (local)"
        }
      },
      "name": "LiteLLM (local)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "{env:LITELLM_MASTER_KEY}",
        "baseURL": "http://127.0.0.1:4000/v1"
      }
    },
    "ollama": {
      "models": {
        "deepseek-coder-v2:16b": {
          "name": "DeepSeek Coder 6.7B"
        },
        "deepseek-coder:6.7b": {
          "name": "DeepSeek Coder 6.7B"
        },
        "gemma3:12b": {
          "name": "Gemma3 12B"
        },
        "llama3.1:8b": {
          "name": "Llama 3.1 8B"
        },
        "llama3.2:3b": {
          "name": "Llama 3.2 3B"
        },
        "ministral-3:14b": {
          "name": "Ministral 3 14B"
        },
        "ministral-3:8b": {
          "name": "Ministral 3 8B"
        },
        "qwen3-coder:latest": {
          "name": "Qwen 3 coder"
        },
        "qwen3:14b": {
          "name": "Qwen 3 14B"
        },
        "starcoder2:15b": {
          "name": "StarCoder 2 15B"
        },
        "starcoder2:3b": {
          "name": "StarCoder 2 3B"
        }
      },
      "name": "Ollama (local)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      }
    }
  }
}
